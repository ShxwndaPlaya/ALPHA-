{
  "name": "devconnect-lan",
  "version": "1.0.0",
  "description": "ALPHA LAN - Offline local network ecosystem for schools, coding clubs, and developers.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/server.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "lint": "eslint . --ext .js,.jsx"
  },
  "keywords": [
    "LAN",
    "offline",
    "chat",
    "IDE",
    "code-collaboration",
    "websocket",
    "education",
    "react",
    "express",
    "nodejs"
  ],
  "author": "ALPHA LAN Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "sqlite3": "^5.1.7",
    "sequelize": "^6.37.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^9.14.0",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
