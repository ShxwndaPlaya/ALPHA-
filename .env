# 🌍 Environment Configuration for ALPHA LAN

# Server settings
PORT=5000
NODE_ENV=development

# Database (SQLite)
DB_PATH=./database/devconnect.db

# JWT Authentication
JWT_SECRET=supersecretlanjwtkey12345
JWT_EXPIRES_IN=7d

# WebRTC / Socket configuration
SOCKET_PORT=5001
LAN_DISCOVERY=true

# Logging
LOG_LEVEL=debug

# Admin setup (for first run)
ADMIN_EMAIL=admin@alphalan.local
ADMIN_PASSWORD=admin123
